{
  "name": "anvl-changelog-feed",
  "version": "1.0.0",
  "description": "RSS and JSON feed generator for ANVL platform changelog and blog. Subscribe to ANVL updates in any RSS reader, Discord, or Telegram bot.",
  "main": "dist/index.js",
  "bin": { "anvl-feed": "./bin/anvl-feed.js" },
  "keywords": ["anvl", "rss", "feed", "changelog", "blog", "solana"],
  "license": "MIT",
  "scripts": {
    "build":     "tsc",
    "generate":  "node dist/index.js generate",
    "serve":     "node dist/index.js serve"
  },
  "dependencies": {
    "express":   "^4.18.3",
    "chalk":     "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node":    "^20.11.30",
    "ts-node":        "^10.9.2",
    "typescript":     "^5.4.2"
  }
}
